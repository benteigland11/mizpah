{
  "prompts_dir": "../../prompts",
  "harness_config": "../harness/tools/config.openai.json",
  "playbook_store": "~/.local/share/playbook/procedures",
  "sandbox": {
    "read_only_binds": [
      "${REPO}",
      "${PYTHON_HOME}",
      "${PYTHON_LINK}",
      "${WIDGET_LIBRARY}",
      "/sys",
      "/etc/fonts"
    ],
    "environment": {
      "PATH": "${VENV}/bin:/usr/bin",
      "WIDGET_LIBRARY_PATH": "${WIDGET_LIBRARY}",
      "HOME": "/work"
    },
    "share_network": true,
    "services": {
      "memory_bytes": 2147483648,
      "processes": 256,
      "lifetime_seconds": 21600,
      "maximum_services": 4,
      "wait_seconds": 1800
    },
    "refused_paths": [
      "${REPO}/engine",
      "${VENV}/lib"
    ],
    "network": {
      "allowed_domains": [
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "proxy_port": 3128,
      "unshare": "unshare",
      "nsenter": "nsenter",
      "socat": "socat"
    },
    "scratch_dirs": [
      "scratch"
    ]
  },
  "turn_budget": {
    "low": 60,
    "medium": 120,
    "high": 240
  },
  "gate_rounds": 3,
  "agent": "mizpah-worker",
  "repeated_failure_rollover": 3,
  "repeated_success_rollover": 5,
  "widget_library": "~/.local/share/cartograph/Widget_Library",
  "turn_cap": 4000,
  "controller_output_tokens": 8192,
  "checkin_output_tokens": 2048,
  "scaffolding": {
    "checkins": true,
    "small_edits": false
  },
  "ops": {
    "model_unit": null,
    "restart_after_seconds": 60,
    "restart_cooldown_seconds": 600,
    "disk_high_percent": 92,
    "notify_command": "notify-send \"$MIZPAH_TITLE\" \"$MIZPAH_BODY\""
  },
  "credentials_file": "~/.local/share/mizpah/credentials.json",
  "providers": {}
}
